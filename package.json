{
  "name": "iaclone",
  "version": "1.0.0",
  "description": "A minimalist, distraction-free markdown writing app",
  "main": "index.js",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:mac": "tauri build --target aarch64-apple-darwin",
    "build:mac-intel": "tauri build --target x86_64-apple-darwin",
    "build:mac-universal": "tauri build --target universal-apple-darwin",
    "build:mac-dmg": "tauri build --target aarch64-apple-darwin --bundles dmg",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cd src-tauri && cargo test",
    "test:all": "npm run test:rust && npm run test"
  },
  "keywords": [
    "markdown",
    "editor",
    "writing"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitest/ui": "^4.0.16",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.3.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "codemirror": "^6.0.2",
    "marked": "^17.0.1"
  }
}
